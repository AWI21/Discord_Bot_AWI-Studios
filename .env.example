# ─────────────────────────────────────────────────────────────────────────────
# WOLFY BOT — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your .env file to GitHub
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_discord_bot_token_here

# ── Bot Presence (shown in Discord sidebar) ────────────────────────────────────
# Types: PLAYING | WATCHING | LISTENING | COMPETING
BOT_STATUS=Watching the pack 🐺
BOT_STATUS_TYPE=WATCHING
# Status: online | idle | dnd | invisible
BOT_ONLINE_STATUS=online

# ── Prefix (default if not set per-server via !config prefix) ─────────────────
DEFAULT_PREFIX=!

# ── Twitch Notifications ──────────────────────────────────────────────────────
# Get these from https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── TikTok Notifications (requires approved TikTok Business API) ──────────────
TIKTOK_ACCESS_TOKEN=

# ── Instagram Notifications (requires approved Meta Graph API) ────────────────
INSTAGRAM_ACCESS_TOKEN=

# ── Port (Render sets this automatically — don't change) ─────────────────────
PORT=3000
